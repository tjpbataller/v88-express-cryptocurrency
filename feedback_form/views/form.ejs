<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="This is the activity for feedback form">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    <title>Feedback Form</title>
</head>
<body>
    <div class="container w-25 mx-auto my-5">
        <h1>Feedback Form</h1>
        <form class="row" action="/result" method="post">
            <label class="form-label">Your Name(Optional):</label>
            <input class="form-control" type="text" name="name">
            <label class="form-label">Course Title:</label>
            <select class="form-control" name="track">
                <option value=""></option>
                <option value="PHP Track">PHP Track</option>
                <option value="JS Track">JS Track</option>
                <option value="Web Fundamentals">Web Fundamentals</option>
            </select>
            <label class="form-label">Given Number (1-10):</label>
            <input class="form-control" type="number" name="rate" min="0" max="10">
            <label class="form-label">Reason:</label>
            <textarea class="form-control" name="reason" cols="30" rows="10"></textarea>
            <input class="btn btn-primary col-3 ms-auto mt-3" type="submit" value="Submit">
        </form>
    </div>
</body>
</html>