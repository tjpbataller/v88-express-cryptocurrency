<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    <title>Document</title>
</head>
<body>
    <div class="container w-25 mx-auto my-5 row">
        <h1 class="mb-5">Submitted Entry</h1>
        <p class="col-6">Your Name(optional):</p>
        <p class="col-6"><%= data.name %></p>
        <p class="col-6">Course Title:</p>
        <p class="col-6"><%= data.track %></p>
        <p class="col-6">Given Score(1-10):</p>
        <p class="col-6"><%= data.rate %>pts</p>
        <p>Reason:</p>
        <p><%= data.reason %></p>
        <a class="btn btn-secondary col-3 mt-5" href="/">Return</a>
    </div>
</body>
</html>