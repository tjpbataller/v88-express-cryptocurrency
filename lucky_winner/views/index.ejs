<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="This is the activity for coupon">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    <script src="../script/script.js" type="text/javascript"></script>
    <title>Free Coupon</title>
</head>
<body>
    <div class="container w-25 mx-auto-my-5 text-center">
        <h1>Welcome Customer!</h1>
        <span>We're giving away <b>free coupons</b> as a token of appreciation</span>
        <% if(submitted == false){ %>
        <span id="counter" class="mb-5"> for first <%= counter %> customer(s)</span>
        <form id="customer-form" action="/claim" method="post">
            <label class="form-label" for="name" >Kindly type your name:</label>
            <input class="form-control" type="text" name="name" id="name" required>
            <input class="btn btn-success mt-3" type="submit">
        </form>
        <% } else { %>
        <div class="row mt-5">
            <p class="fs-3 fw-normal"><%= discount %></p>
            <p class="fs-1 fw-bolder"><%= coupon %></p>
            <form class="col-6" action="/reset" method="post">
                <input class="btn btn-secondary" type="submit" value="Reset Count">
            </form>
            <form class="col-6" action="/again" method="post">
                <input class="btn btn-success" type="submit" value="Claim Again">
            </form>
        </div>
        <% } %>
    </div>
</body>
</html>